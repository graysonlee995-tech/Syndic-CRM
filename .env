# ---- App
# Public address of the CRM (used for links in alert emails).
APP_URL=http://localhost:5173
# Domain Caddy requests an HTTPS certificate for (production only).
DOMAIN=crm.example.com
SERVER_PORT=3000
DATA_DIR=./data
APP_TIMEZONE=Asia/Karachi
SESSION_IDLE_HOURS=8

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# KEEP THIS SAFE AND BACKED UP: without it uploaded documents cannot be decrypted.
FILE_ENCRYPTION_KEY=4gRg/I45b7kUFTWvOuJJjpIRYeDT258LYrmNLA9JHa4=

# ---- Email (company SMTP mailbox)
# Office 365: smtp.office365.com, port 587, SMTP_SECURE=false
# Gmail / Google Workspace: smtp.gmail.com, port 465, SMTP_SECURE=true, use an App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Syndic CRM <crm@your-agency.com>"

# AI assistant: paste your key from console.anthropic.com after the = sign, then save
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxx...
