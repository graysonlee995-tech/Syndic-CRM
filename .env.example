# ---- App
# Public address of the CRM (used for links in alert emails).
APP_URL=http://localhost:5173
# Domain Caddy requests an HTTPS certificate for (Docker VPS setup only).
DOMAIN=crm.example.com
SERVER_PORT=3000
DATA_DIR=./data
APP_TIMEZONE=Asia/Karachi
SESSION_IDLE_HOURS=8

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# KEEP THIS SAFE AND BACKED UP: without it uploaded documents cannot be decrypted.
# Use the SAME key locally and on the server if you copy data between them.
FILE_ENCRYPTION_KEY=

# ---- Supabase (production)
# Leave these empty for local development: the CRM then uses an embedded
# Postgres in DATA_DIR/pgdata and keeps files in DATA_DIR/files.
#
# Database: Supabase dashboard > Connect > "Session pooler" connection string, e.g.
#   postgresql://postgres.abcdefgh:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
# Files: optional. Without these, encrypted uploads are stored in the database (stored_files table).
# With them, they go to a private Supabase Storage bucket. The service role key is a secret: server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket for encrypted uploads (created automatically).
SUPABASE_BUCKET=crm-files

# ---- Vercel
# Random secret Vercel Cron sends to /api/cron/daily (set it in Vercel's environment variables).
CRON_SECRET=
# Largest upload in MB. Defaults to 4 on Vercel (its request limit is 4.5 MB) and 15 elsewhere.
# MAX_UPLOAD_MB=15

# ---- AI assistant (Claude)
# API key from console.anthropic.com > API Keys. Leave empty to hide the assistant.
# Conversations are sent to Anthropic; passport and ID numbers never are.
ANTHROPIC_API_KEY=
# Model used by the assistant (default: Claude Sonnet 5.5).
# ASSISTANT_MODEL=claude-sonnet-5-5

# ---- Email (company SMTP mailbox)
# Office 365: smtp.office365.com, port 587, SMTP_SECURE=false
# Gmail / Google Workspace: smtp.gmail.com, port 465, SMTP_SECURE=true, use an App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Syndic CRM <crm@your-agency.com>"
