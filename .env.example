# ---- App
# Public address of the CRM (used for links in alert emails).
APP_URL=http://localhost:5173
SERVER_PORT=3000
APP_TIMEZONE=Asia/Karachi
SESSION_IDLE_HOURS=8

# ---- Database (Supabase)
# Supabase > Connect (top bar) > Connection string > "Session pooler". Put your database password in it.
# Local development can use a local Postgres instead, e.g. postgres://postgres:postgres@localhost:5432/crm
DATABASE_URL=

# ---- File storage (Supabase Storage)
# Supabase > Project Settings > API: Project URL and the service_role secret key.
# Keep the service role key secret: it is only ever used by the server.
# Leave both empty to store files in DATA_DIR/files on this computer instead.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=documents
DATA_DIR=./data

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# KEEP THIS SAFE AND BACKED UP: without it uploaded documents cannot be decrypted.
FILE_ENCRYPTION_KEY=

# ---- Daily alerts
# true: the server runs its own daily timer (always on servers, local development).
# false: on Vercel. Vercel Cron (vercel.json) calls /api/cron/daily every day at 03:00 UTC (08:00 Pakistan).
IN_APP_SCHEDULER=true
# Long random value. On Vercel, Vercel Cron sends it to /api/cron/daily automatically. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=

# ---- First admin (optional)
# Creates this admin on first use while there are no employees yet (needed on Vercel, which has no console). Remove the password afterwards.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PASSWORD=

# ---- Email (company SMTP mailbox)
# Office 365: smtp.office365.com, port 587, SMTP_SECURE=false
# Gmail / Google Workspace: smtp.gmail.com, port 465, SMTP_SECURE=true, use an App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Syndic CRM <crm@syndictravel.com>"
